    /* ================= CATEGORY ================= */

    function selectCategory(category, btnElement) {

        currentCategory = category;


        const buttons =
            document.querySelectorAll('.cat-btn');


        buttons.forEach(btn => {

            btn.classList.remove(
                'bg-amber-500',
                'text-slate-900',
                'font-bold',
                'shadow'
            );

            btn.classList.add('hover:bg-indigo-800');

        });


        if (btnElement) {

            btnElement.classList.add(
                'bg-amber-500',
                'text-slate-900',
                'font-bold',
                'shadow'
            );

            btnElement.classList.remove(
                'hover:bg-indigo-800'
            );

        }


        const title =
            document.getElementById('categoryTitle');


        title.innerHTML = `
            <span
                class="w-2.5 h-7 bg-indigo-600 rounded-full
                       inline-block">
            </span>

            ${category === 'all'
                ? 'সকল পণ্যসমূহ'
                : category}
        `;


        filterProducts();

    }


    /* ================= SEARCH ================= */

    function filterProducts() {

        const query =
            document.getElementById('searchInput')
                .value
                .toLowerCase()
                .trim();


        let filtered = products;


        if (currentCategory !== 'all') {

            filtered =
                filtered.filter(
                    p => p.category === currentCategory
                );

        }


        if (query !== '') {

            filtered =
                filtered.filter(
                    p =>
                        p.name.toLowerCase().includes(query) ||
                        p.category.toLowerCase().includes(query)
                );

        }


        renderProducts(filtered);

    }


    /* Mobile Search */

    function filterProductsMobile() {

        document.getElementById('searchInput').value =
            document.getElementById('mobileSearchInput').value;

        filterProducts();

    }


    /* ================= SELECT PRODUCT ================= */

    function selectProductForForm(productName) {

        const productField =
            document.getElementById('custProductName');


        productField.value = productName;


        showToast(
            `"${productName}" ফর্মে সিলেক্ট করা হয়েছে!`
        );


        const orderSection =
            document.getElementById('orderFormSection');


        orderSection.scrollIntoView({
            behavior: 'smooth'
        });

    }


    /* ================= WHATSAPP INQUIRY ================= */

    function directWhatsAppInquiry(productName, category) {

        const message =
            `হ্যালো *আব্দুল্লাহ টেলিকম*, ` +
            `আমি নিম্নোক্ত পণ্যটি সম্পর্কে বিস্তারিত জানতে চাই:%0A%0A` +
            `• *পণ্য:* ${productName}%0A` +
            `• *ক্যাটাগরি:* ${category}`;


        window.open(
            `https://wa.me/${sellerWhatsAppNumber}?text=${message}`,
            '_blank'
        );

    }


    /* ================= ORDER FORM ================= */

    function handleFormSubmit(event) {

        event.preventDefault();


        const name =
            document.getElementById('custName')
                .value
                .trim();


        const productName =
            document.getElementById('custProductName')
                .value
                .trim();


        const phone =
            document.getElementById('custPhone')
                .value
                .trim();


        const address =
            document.getElementById('custAddress')
                .value
                .trim();


        if (
            !name ||
            !productName ||
            !phone ||
            !address
        ) {

            alert(
                'দয়া করে সকল তথ্য প্রদান করুন।'
            );

            return;
        }


        let text =
            `*নতুন অর্ডার (আব্দুল্লাহ টেলিকম)*%0A%0A`;


        text +=
            `*নাম :* ${name}%0A`;


        text +=
            `*পন্যের নাম :* ${productName}%0A`;


        text +=
            `*মুমাইল নাম্বার :* ${phone}%0A`;


        text +=
            `*ঠিকানা :* ${address}%0A%0A`;


        text +=
            `দয়া করে অর্ডারটি নিশ্চিত করুন।`;


        showToast(
            "হোয়াটসঅ্যাপে অর্ডার প্রস্তুত করা হচ্ছে..."
        );


        window.open(
            `https://wa.me/${sellerWhatsAppNumber}?text=${text}`,
            '_blank'
        );

    }


    /* ================= TOAST ================= */

    function showToast(message) {

        const toast =
            document.getElementById('toast');


        const toastMsg =
            document.getElementById('toastMsg');


        toastMsg.innerText = message;


        toast.classList.remove(
            'opacity-0',
            'pointer-events-none'
        );


        toast.classList.add(
            'opacity-100'
        );


        setTimeout(() => {

            toast.classList.remove(
                'opacity-100'
            );


            toast.classList.add(
                'opacity-0',
                'pointer-events-none'
            );

        }, 2500);

    }


    /* ================= INITIAL LOAD ================= */

    window.onload = function() {

        renderProducts(products);

