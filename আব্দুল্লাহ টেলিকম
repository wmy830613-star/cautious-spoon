                                   focus:ring-2 focus:ring-indigo-500
                                   focus:border-indigo-500 outline-none
                                   transition bg-gray-50 focus:bg-white">

                    </div>

                </div>


                <!-- Product Name -->
                <div>

                    <label
                        class="block text-xs font-bold text-gray-800 mb-1.5">

                        পন্যের নাম :

                    </label>


                    <div class="relative">

                        <i
                            class="fa-solid fa-box-open absolute left-3.5
                                   top-3.5 text-gray-400 text-sm">
                        </i>


                        <input
                            type="text"
                            id="custProductName"
                            required
                            placeholder="আপনি যে পণ্যটি কিনতে চান তার নাম লিখুন"
                            class="w-full pl-10 pr-4 py-2.5 text-sm
                                   border border-gray-300 rounded-xl
                                   focus:ring-2 focus:ring-indigo-500
                                   focus:border-indigo-500 outline-none
                                   transition bg-gray-50 focus:bg-white">

                    </div>

                </div>


                <!-- Phone -->
                <div>

                    <label
                        class="block text-xs font-bold text-gray-800 mb-1.5">

                        মুমাইল নাম্বার :

                    </label>


                    <div class="relative">

                        <i
                            class="fa-solid fa-phone absolute left-3.5 top-3.5
                                   text-gray-400 text-sm">
                        </i>


                        <input
                            type="tel"
                            id="custPhone"
                            required
                            placeholder="আপনার ১১ ডিজিটের মোবাইল নম্বর"
                            class="w-full pl-10 pr-4 py-2.5 text-sm
                                   border border-gray-300 rounded-xl
                                   focus:ring-2 focus:ring-indigo-500
                                   focus:border-indigo-500 outline-none
                                   transition bg-gray-50 focus:bg-white">

                    </div>

                </div>


                <!-- Address -->
                <div>

                    <label
                        class="block text-xs font-bold text-gray-800 mb-1.5">

                        ঠিকানা :

                    </label>


                    <div class="relative">

                        <i
                            class="fa-solid fa-location-dot absolute left-3.5
                                   top-3.5 text-gray-400 text-sm">
                        </i>


                        <textarea
                            id="custAddress"
                            required
                            rows="3"
                            placeholder="গ্রাম/রাস্তা, থানা, জেলা সহ সম্পূর্ণ ঠিকানা লিখুন"
